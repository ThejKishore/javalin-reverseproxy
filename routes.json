[
  {
    "audit-enabled": false,
    "audit-store": "database",
    "auth-forward-headers": [
      "Authorization",
      "X-API-Key"
    ],
    "cache-policy": {
      "cache-key-strategy": "METHOD_PATH_QUERY",
      "enabled": false,
      "ttl-seconds": 300
    },
    "circuit-breaker-policy": {
      "enabled": false,
      "failure-rate-threshold": 50,
      "sliding-window-size": 10,
      "wait-duration-seconds": 60
    },
    "csp-policy": {
      "enabled": false,
      "exclude-paths": [],
