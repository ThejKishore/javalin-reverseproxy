        "X-Powered-By": "javalin-gateway"
      },
      "dedupe-response-headers": [
        "Access-Control-Allow-Origin"
      ],
      "exclude-request": [
        "Cookie"
      ],
      "exclude-response": [
        "Server"
      ]
    },
    "http-validation-policy": {
      "enabled": false,
      "exclude-paths": [],
      "validate-body": false,
      "validate-cookies": true,
      "validate-headers": true,
      "validate-query-params": true
    },
    "id": "example-service",
