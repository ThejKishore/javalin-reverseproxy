    },
    "routing-type": "PATH",
    "strip-prefix": "/api/example",
    "targets": [
      {
        "header-match-name": null,
        "header-match-value": null,
        "url": "https://jsonplaceholder.typicode.com",
        "weight": 1
      }
    ],
    "timeout-ms": 5000
  },
